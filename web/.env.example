# Copy to .env.local. Values below are identifiers, never permanent tokens.
# Local access is loopback-only and checks the current browser address.
LOCAL_DEMO_MODE=true
APP_ORIGIN=http://127.0.0.1:3017
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_PROFILE=your-authorized-cli-profile
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_FEEDBACK_TABLE=workspace.papaeats_app_demo.feedback_with_issue_type
FEEDBACK_BACKEND=sql
SUBMISSION_JOB_ID=
PGHOST=
PGPORT=5432
PGDATABASE=databricks_postgres
PGUSER=
PGSSLMODE=require
LAKEBASE_ENDPOINT=projects/your-project/branches/your-branch/endpoints/primary
ENABLE_DECISIONS=false
# Optional future serving path: explicitly set FEEDBACK_BACKEND=postgres after
# verifying a synced table. PGHOST alone does not switch the analysis read path.
# FEEDBACK_TABLE=papaeats.feedback_with_issue_type
# Deployed Apps: omit LOCAL_DEMO_MODE and DATABRICKS_PROFILE, set APP_ORIGIN to
# the hosted URL, configure authenticated ingress and grant the app SP access.
